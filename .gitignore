# E-Fulfill Hub

# Secrets — NEVER commit real credentials.
# .env holds DATABASE_URL / JWT_SECRET / ENCRYPTION_KEY / SHOPEE_PARTNER_KEY.
# Only the template .env.example is tracked.
.env
.env.*
!.env.example

# Production
.next/
out/
build/
*.tsbuildinfo
.turbo/

# Dependencies
node_modules/

# Prisma
prisma/generated/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Temporary / Scratch
scratch_*.ts
*.jfif

# Python bytecode (hasil kompilasi skrip deploy)
__pycache__/
*.py[cod]

# Tangkapan layar verifikasi + catatan internal tidak untuk repo
docs/screenshots/
