# ────────────────────────────────────────────────────────────────
# E-Fulfill Hub — environment configuration
# Copy to `.env.local` (or `.env`) and fill in the real values.
# ────────────────────────────────────────────────────────────────

# ── Database (MySQL 8) ─────────────────────────────────────────
# Prisma uses this URL. Create the database first, e.g.:
#   CREATE DATABASE efulfillhub CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root@localhost:3306/efulfillhub"

# ── Authentication ──────────────────────────────────────────────
# 32+ byte random secret for signing the httpOnly session JWT.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME_USE_A_LONG_RANDOM_SECRET_IN_PRODUCTION"
JWT_EXPIRES_IN="7d"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# ── Encryption key for integration credentials (at rest) ───────
# MUST be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS_ENCRYPTION_KEY_HERE"

# ── Shopee Open Platform v2 (required for real sync) ───────────
# From the Shopee Open Platform Console (App Console > App Settings).
# Leave empty while your partner account is still under review —
# the system is fully ready and will activate as soon as these are set.
SHOPEE_PARTNER_ID="1245182"
SHOPEE_PARTNER_KEY="shpk704a73565a484271694746675567614865415043425376495773746f6e74"
SHOPEE_REDIRECT_URL="http://localhost:3000/api/v1/integrations/shopee/callback"
SHOPEE_API_HOST="https://partner.shopeemobile.com"
# Set to "true" to run against the sandbox (for testing before going live).
SHOPEE_SANDBOX="true"
SHOPEE_SANDBOX_HOST="https://partner.test-stable.shopeemobile.com"
